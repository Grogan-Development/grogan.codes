# Optional. Everything here can instead be set in the app's Settings (stored in the macOS Keychain).
# Copy to .env.local to use. Never commit real values.

# AWS profile the app uses (needs the CodespaceApp policy; see infra/README.md).
CODESPACE_AWS_PROFILE=
# Regions workspaces may run in, home region first.
CODESPACE_AWS_REGIONS=us-east-1,us-east-2,us-west-2
# Days a stopped workspace waits before moving to a snapshot (0 = never).
CODESPACE_COLD_AFTER_DAYS=3
# From `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Extra hostnames allowed to reach the app (it has no login; keep it on localhost unless you add one).
CODESPACE_ALLOWED_HOSTS=
